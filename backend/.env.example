# Aperture backend configuration. Copy to .env and adjust.
# No real secrets belong in this file — local single-user app.

# Postgres runs in Docker on host port 5435 (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://aperture:aperture@localhost:5435/aperture

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Rotating JSON log directory (10 MB x 5 files). Read it with:
#   tail -f ~/.aperture/logs/aperture.log | jq .
# Set to empty to log to stdout only; the test suite does this.
LOG_DIR=~/.aperture/logs

# App-managed generated data (safe to delete; rebuilt on demand).
THUMBNAIL_CACHE_DIR=~/.aperture/thumbnails

# "Deleted" photos are moved here, never removed directly (Phase 6).
QUARANTINE_DIR=~/.aperture/quarantine

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# Scan processing: -1 = one worker process per CPU core minus one,
# 0 = serial in-process (debugging), N = exactly N worker processes.
SCAN_WORKERS=-1

# Files processed and committed per batch during a scan.
SCAN_BATCH_SIZE=500

# Max pHash Hamming distance for "visually similar" (0-7; above 7 loses the
# completeness guarantee of the 8-band LSH candidate lookup).
SIMILAR_HAMMING_THRESHOLD=6

# --- Telemetry (optional, off by default) -----------------------------------
# Traces are vendor-neutral OpenTelemetry over OTLP/HTTP. Spans carry ids,
# counts and outcomes only — never a filesystem path, filename or username.
# One span per request, one per SQL statement beneath it. Queries are safe to
# send because every value is a bind parameter: db.statement keeps the
# placeholder, not the path. A traced scan touches every photo, so it emits far
# more spans than browsing does — watch your vendor quota the first time.
TELEMETRY_ENABLED=0

# Print spans instead of exporting them. Use this to inspect exactly what would
# be sent before anything leaves the machine.
TELEMETRY_CONSOLE_EXPORT=0

# Destination. These are the OTel SDK's own variables, read from the process
# environment rather than mirrored into Settings — the SDK appends /v1/traces to
# the endpoint, and passing it through Settings would skip that and post to the
# wrong URL.
#   Honeycomb: https://api.honeycomb.io  + OTEL_EXPORTER_OTLP_HEADERS
#   Local:     http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<your-ingest-key>

# Deliberately NOT set: OTEL_EXPERIMENTAL_RESOURCE_DETECTORS. The process and OS
# detectors attach command lines and hostnames, which would put your username
# and paths on every span.
